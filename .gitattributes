# Tüm metin dosyaları depoda LF ile saklanır; Windows'ta çalışma kopyası
# CRLF olabilir. Bu, PowerShell 5.1 round-trip'lerinden kaynaklanan kodlama
# bozulmalarını ve gereksiz diff gürültüsünü azaltır.
* text=auto eol=lf

*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.py text eol=lf
*.xdf text eol=lf
*.ini text eol=lf
*.txt text eol=lf

# İkili dosyalar asla dönüştürülmez
*.bin binary
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
